{
 "id": "thornfield/hesta_thorne",
 "start": "greet",
 "nodes": {
  "greet": {
   "lines": [
    {
     "text": "{first} looks you up and down and says nothing at all.",
     "if": {
      "tier": "enemy"
     },
     "p": 5
    },
    {
     "text": "\"You again. Say what you want and be quick about it.\"",
     "if": {
      "tier": "rival"
     },
     "p": 5
    },
    {
     "text": "\"First pint is free if you can name the hop.\"",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"{greeting}\" {first} nods.",
     "if": {
      "tier": "stranger"
     },
     "p": 1
    },
    {
     "text": "\"Well met, {player}.\"",
     "if": {
      "tier": [
       "friend",
       "close_friend"
      ]
     },
     "p": 3
    }
   ],
   "choices": [
    {
     "text": "\"Heard any news?\"",
     "goto": "rumour",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "\"What do you make of Odo?\"",
     "goto": "op_odo_marsh",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "\"What do you make of Wilm?\"",
     "goto": "op_wilm_garrow",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "\"What do you make of Reeve?\"",
     "goto": "op_reeve_alden",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "Offer a gift\u2026",
     "goto": "",
     "if": {
      "has": "has_gift_items"
     },
     "do": [
      [
       "gift"
      ]
     ]
    },
    {
     "text": "\"Good day to you.\"",
     "goto": "@end"
    }
   ]
  },
  "rumour": {
   "lines": [
    {
     "text": "\"The tithe barn is half full. Half. After a good harvest.\"",
     "p": 2
    },
    {
     "text": "\"{rumour}\"",
     "if": {
      "has": "rumour"
     },
     "p": 1
    },
    {
     "text": "\"Nothing I would repeat.\"",
     "p": 0
    }
   ],
   "choices": [
    {
     "text": "\"Anything else?\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks for telling me.\"",
     "goto": "greet",
     "do": [
      [
       "opinion",
       "chat",
       "Pleasant talk",
       2,
       5
      ]
     ]
    }
   ]
  },
  "op_odo_marsh": {
   "lines": [
    {
     "text": "\"Odo has the best nose in the vale and the worst temper.\""
    }
   ],
   "choices": [
    {
     "text": "\"Go on.\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks.\"",
     "goto": "greet"
    }
   ]
  },
  "op_wilm_garrow": {
   "lines": [
    {
     "text": "\"Wilm drinks more than he pays for. I keep a tab. He keeps promises about it.\""
    }
   ],
   "choices": [
    {
     "text": "\"Go on.\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks.\"",
     "goto": "greet"
    }
   ]
  },
  "op_reeve_alden": {
   "lines": [
    {
     "text": "\"Alden counts barley the way I count grudges: carefully, and aloud.\""
    }
   ],
   "choices": [
    {
     "text": "\"Go on.\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks.\"",
     "goto": "greet"
    }
   ]
  }
 }
}