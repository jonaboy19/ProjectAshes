{
 "id": "blackwater/seren_jessop",
 "start": "greet",
 "nodes": {
  "greet": {
   "lines": [
    {
     "text": "{first} looks you up and down and says nothing at all.",
     "if": {
      "tier": "enemy"
     },
     "p": 5
    },
    {
     "text": "\"You again. Say what you want and be quick about it.\"",
     "if": {
      "tier": "rival"
     },
     "p": 5
    },
    {
     "text": "\"Everything has a price. Some of it is even written down.\"",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"The Blackwater Ford Post is not much to look at. It is, however, ours.\"",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"Rain on the wall. The sentries grumble. The mud grumbles louder.\"",
     "if": {
      "weather": "rain",
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 3
    },
    {
     "text": "\"{greeting}\" {first} nods.",
     "if": {
      "tier": "stranger"
     },
     "p": 1
    },
    {
     "text": "\"Friend, you know I will not change my mind. Ask anyway. I enjoy refusing you.\"",
     "if": {
      "tier": [
       "friend",
       "close_friend"
      ]
     },
     "p": 4
    },
    {
     "text": "\"Well met, {player}.\"",
     "if": {
      "tier": [
       "friend",
       "close_friend"
      ]
     },
     "p": 3
    }
   ],
   "choices": [
    {
     "text": "\"Heard any news?\"",
     "goto": "rumour",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "\"What do you make of Gunnar?\"",
     "goto": "op_gunnar_wainwright",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "\"What do you make of Hedda?\"",
     "goto": "op_hedda_coldwell",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "Offer a gift…",
     "goto": "",
     "if": {
      "has": "has_gift_items"
     },
     "do": [
      [
       "gift"
      ]
     ]
    },
    {
     "text": "\"Good day to you.\"",
     "goto": "@end"
    }
   ]
  },
  "rumour": {
   "lines": [
    {
     "text": "\"Whetstones and bandages go first. I try not to think about what that means.\"",
     "p": 2
    },
    {
     "text": "\"Folk buy more than they need, then bring half back. Fear shops strangely.\"",
     "p": 2
    },
    {
     "text": "\"Wolves test the line at dusk. Men test it at dawn. We hold either way.\"",
     "p": 2
    },
    {
     "text": "\"If trade slows, Blackwater feels it first. If it speeds up, Blackwater feels it last.\"",
     "p": 2
    },
    {
     "text": "\"{rumour}\"",
     "if": {
      "has": "rumour"
     },
     "p": 1
    },
    {
     "text": "\"Nothing I would repeat.\"",
     "p": 0
    }
   ],
   "choices": [
    {
     "text": "\"Anything else?\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks for telling me.\"",
     "goto": "greet",
     "do": [
      [
       "opinion",
       "chat",
       "Pleasant talk",
       2,
       5
      ]
     ]
    }
   ]
  },
  "op_gunnar_wainwright": {
   "lines": [
    {
     "text": "\"Gunnar undercuts me. I forgive Gunnar. Mostly.\""
    }
   ],
   "choices": [
    {
     "text": "\"Go on.\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks.\"",
     "goto": "greet"
    }
   ]
  },
  "op_hedda_coldwell": {
   "lines": [
    {
     "text": "\"Hedda keeps a tidy yard and an untidy mouth.\""
    }
   ],
   "choices": [
    {
     "text": "\"Go on.\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks.\"",
     "goto": "greet"
    }
   ]
  }
 }
}
