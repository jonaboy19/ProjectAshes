{
 "id": "highcliff/parsley_rawlin",
 "start": "greet",
 "nodes": {
  "greet": {
   "lines": [
    {
     "text": "{first} looks you up and down and says nothing at all.",
     "if": {
      "tier": "enemy"
     },
     "p": 5
    },
    {
     "text": "\"You again. Say what you want and be quick about it.\"",
     "if": {
      "tier": "rival"
     },
     "p": 5
    },
    {
     "text": "\"You are somebody's grandchild. I can tell by the walk.\"",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"Highcliff is a small place with a long memory. State your name slowly.\"",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"Evening watch. Stand easy, but not too easy.\"",
     "if": {
      "time": "evening",
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"{greeting}\" {first} nods.",
     "if": {
      "tier": "stranger"
     },
     "p": 1
    },
    {
     "text": "\"A bright day and a bright friend! What luck!\"",
     "if": {
      "tier": [
       "friend",
       "close_friend"
      ]
     },
     "p": 4
    },
    {
     "text": "\"Well met, {player}.\"",
     "if": {
      "tier": [
       "friend",
       "close_friend"
      ]
     },
     "p": 3
    }
   ],
   "choices": [
    {
     "text": "\"Heard any news?\"",
     "goto": "rumour",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "\"What do you make of Piers?\"",
     "goto": "op_piers_rawlin",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "Offer a gift…",
     "goto": "",
     "if": {
      "has": "has_gift_items"
     },
     "do": [
      [
       "gift"
      ]
     ]
    },
    {
     "text": "\"Good day to you.\"",
     "goto": "@end"
    }
   ]
  },
  "rumour": {
   "lines": [
    {
     "text": "\"When I was young the stones sang at dusk. Now they hum, like someone ill.\"",
     "p": 2
    },
    {
     "text": "\"The armoury is short on arrowheads. The smith is short on iron. The iron is short on road.\"",
     "p": 2
    },
    {
     "text": "\"Every few years Highcliff has a winter nobody forgets. The old folk say this one is early.\"",
     "p": 2
    },
    {
     "text": "\"{rumour}\"",
     "if": {
      "has": "rumour"
     },
     "p": 1
    },
    {
     "text": "\"Nothing I would repeat.\"",
     "p": 0
    }
   ],
   "choices": [
    {
     "text": "\"Anything else?\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks for telling me.\"",
     "goto": "greet",
     "do": [
      [
       "opinion",
       "chat",
       "Pleasant talk",
       2,
       5
      ]
     ]
    }
   ]
  },
  "op_piers_rawlin": {
   "lines": [
    {
     "text": "\"Piers and I share a roof and a temper. Mostly the temper.\""
    }
   ],
   "choices": [
    {
     "text": "\"Go on.\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks.\"",
     "goto": "greet"
    }
   ]
  }
 }
}
