{
 "id": "saltwick/hewitt_tolliver",
 "start": "greet",
 "nodes": {
  "greet": {
   "lines": [
    {
     "text": "{first} looks you up and down and says nothing at all.",
     "if": {
      "tier": "enemy"
     },
     "p": 5
    },
    {
     "text": "\"You again. Say what you want and be quick about it.\"",
     "if": {
      "tier": "rival"
     },
     "p": 5
    },
    {
     "text": "\"Loaf, bun, or the heel nobody wants? The heel is free.\"",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"Strangers in Saltwick get one warning and one welcome. You are on the welcome.\"",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"Dawn tide. The boats are out.\"",
     "if": {
      "time": "morning",
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"{greeting}\" {first} nods.",
     "if": {
      "tier": "stranger"
     },
     "p": 1
    },
    {
     "text": "\"You know me. You know my work. I will not insult either by modesty.\"",
     "if": {
      "tier": [
       "friend",
       "close_friend"
      ]
     },
     "p": 4
    },
    {
     "text": "\"Well met, {player}.\"",
     "if": {
      "tier": [
       "friend",
       "close_friend"
      ]
     },
     "p": 3
    }
   ],
   "choices": [
    {
     "text": "\"Heard any news?\"",
     "goto": "rumour",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "\"What do you make of Sander?\"",
     "goto": "op_sander_tolliver",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "Offer a gift…",
     "goto": "",
     "if": {
      "has": "has_gift_items"
     },
     "do": [
      [
       "gift"
      ]
     ]
    },
    {
     "text": "\"Good day to you.\"",
     "goto": "@end"
    }
   ]
  },
  "rumour": {
   "lines": [
    {
     "text": "\"A sack of flour came in short, twice. The miller swears by his scales.\"",
     "p": 2
    },
    {
     "text": "\"A seal followed my boat for a mile and spoke. I did not answer.\"",
     "p": 2
    },
    {
     "text": "\"A pinch of salt on the doorstep keeps small dark things out, say Saltwick folk.\"",
     "p": 2
    },
    {
     "text": "\"{rumour}\"",
     "if": {
      "has": "rumour"
     },
     "p": 1
    },
    {
     "text": "\"Nothing I would repeat.\"",
     "p": 0
    }
   ],
   "choices": [
    {
     "text": "\"Anything else?\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks for telling me.\"",
     "goto": "greet",
     "do": [
      [
       "opinion",
       "chat",
       "Pleasant talk",
       2,
       5
      ]
     ]
    }
   ]
  },
  "op_sander_tolliver": {
   "lines": [
    {
     "text": "\"Sander and I share a roof and a temper. Mostly the temper.\""
    }
   ],
   "choices": [
    {
     "text": "\"Go on.\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks.\"",
     "goto": "greet"
    }
   ]
  }
 }
}
