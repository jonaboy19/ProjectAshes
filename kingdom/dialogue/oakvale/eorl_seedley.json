{
 "id": "oakvale/eorl_seedley",
 "start": "greet",
 "nodes": {
  "greet": {
   "lines": [
    {
     "text": "{first} looks you up and down and says nothing at all.",
     "if": {
      "tier": "enemy"
     },
     "p": 5
    },
    {
     "text": "\"You again. Say what you want and be quick about it.\"",
     "if": {
      "tier": "rival"
     },
     "p": 5
    },
    {
     "text": "\"Reeve here. Yes, it is as dull as it sounds. Ask anyway.\"",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"Strangers in Greenhollow get one warning and one welcome. You are on the welcome.\"",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"Early start. The field has been awake an hour.\"",
     "if": {
      "time": "morning",
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"{greeting}\" {first} nods.",
     "if": {
      "tier": "stranger"
     },
     "p": 1
    },
    {
     "text": "\"Smell the air, friend. Rain by supper. Bring a cloak, or come in.\"",
     "if": {
      "tier": [
       "friend",
       "close_friend"
      ]
     },
     "p": 4
    },
    {
     "text": "\"Well met, {player}.\"",
     "if": {
      "tier": [
       "friend",
       "close_friend"
      ]
     },
     "p": 3
    }
   ],
   "choices": [
    {
     "text": "\"Heard any news?\"",
     "goto": "rumour",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "\"What do you make of Dacey?\"",
     "goto": "op_dacey_dobbin",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "Offer a gift…",
     "goto": "",
     "if": {
      "has": "has_gift_items"
     },
     "do": [
      [
       "gift"
      ]
     ]
    },
    {
     "text": "\"Good day to you.\"",
     "goto": "@end"
    }
   ]
  },
  "rumour": {
   "lines": [
    {
     "text": "\"Everyone owes everyone a little. Nobody agrees on the sum.\"",
     "p": 2
    },
    {
     "text": "\"The scarecrow by the north field has moved twice. The farmer says he did not touch it.\"",
     "p": 2
    },
    {
     "text": "\"The south fields have gone violet at the edge. Only a little. Somebody says it's the light.\"",
     "p": 2
    },
    {
     "text": "\"{rumour}\"",
     "if": {
      "has": "rumour"
     },
     "p": 1
    },
    {
     "text": "\"Nothing I would repeat.\"",
     "p": 0
    }
   ],
   "choices": [
    {
     "text": "\"Anything else?\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks for telling me.\"",
     "goto": "greet",
     "do": [
      [
       "opinion",
       "chat",
       "Pleasant talk",
       2,
       5
      ]
     ]
    }
   ]
  },
  "op_dacey_dobbin": {
   "lines": [
    {
     "text": "\"Dacey lives next door and hears everything I do.\""
    }
   ],
   "choices": [
    {
     "text": "\"Go on.\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks.\"",
     "goto": "greet"
    }
   ]
  }
 }
}
