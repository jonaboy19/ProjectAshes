{
 "id": "skarholm/idony_keld",
 "start": "greet",
 "nodes": {
  "greet": {
   "lines": [
    {
     "text": "{first} looks you up and down and says nothing at all.",
     "if": {
      "tier": "enemy"
     },
     "p": 5
    },
    {
     "text": "\"You again. Say what you want and be quick about it.\"",
     "if": {
      "tier": "rival"
     },
     "p": 5
    },
    {
     "text": "\"Mind the lamp. Mind the roof. Mind me.\"",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"Folk come to Skarholm for ore and coal. Some stay for the quiet.\"",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"Night shift. Keep your voice low. The rock listens.\"",
     "if": {
      "time": "night",
      "tier_not": [
       "enemy",
       "rival"
      ]
     },
     "p": 2
    },
    {
     "text": "\"{greeting}\" {first} nods.",
     "if": {
      "tier": "stranger"
     },
     "p": 1
    },
    {
     "text": "\"Ha! Friend! Pull up a stool, I have a story and half a loaf.\"",
     "if": {
      "tier": [
       "friend",
       "close_friend"
      ]
     },
     "p": 4
    },
    {
     "text": "\"Well met, {player}.\"",
     "if": {
      "tier": [
       "friend",
       "close_friend"
      ]
     },
     "p": 3
    }
   ],
   "choices": [
    {
     "text": "\"Heard any news?\"",
     "goto": "rumour",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "\"What do you make of Bartle?\"",
     "goto": "op_bartle_eastman",
     "if": {
      "tier_not": [
       "enemy",
       "rival"
      ]
     }
    },
    {
     "text": "Offer a gift…",
     "goto": "",
     "if": {
      "has": "has_gift_items"
     },
     "do": [
      [
       "gift"
      ]
     ]
    },
    {
     "text": "\"Good day to you.\"",
     "goto": "@end"
    }
   ]
  },
  "rumour": {
   "lines": [
    {
     "text": "\"The north shaft is shut again. The foreman says the roof. The miners say not.\"",
     "p": 2
    },
    {
     "text": "\"Skarholm lives by ore and coal. When that fails, so do we.\"",
     "p": 2
    },
    {
     "text": "\"{rumour}\"",
     "if": {
      "has": "rumour"
     },
     "p": 1
    },
    {
     "text": "\"Nothing I would repeat.\"",
     "p": 0
    }
   ],
   "choices": [
    {
     "text": "\"Anything else?\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks for telling me.\"",
     "goto": "greet",
     "do": [
      [
       "opinion",
       "chat",
       "Pleasant talk",
       2,
       5
      ]
     ]
    }
   ]
  },
  "op_bartle_eastman": {
   "lines": [
    {
     "text": "\"Bartle works hard and talks harder.\""
    }
   ],
   "choices": [
    {
     "text": "\"Go on.\"",
     "goto": "rumour"
    },
    {
     "text": "\"Thanks.\"",
     "goto": "greet"
    }
   ]
  }
 }
}
