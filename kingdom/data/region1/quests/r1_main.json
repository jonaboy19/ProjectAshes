			"objective": "Hear what happened to the Miller's Stone",
			"journal": "At supper the Miller's Stone went out. Mother wants me indoors. Warden Idra is up there with a lantern.",
			"giver": "mother", "place": "ashford",
			"requires": {"if": {"min_age": 8}},
			"dialogue": [{"node": "mother_dusk"}],
