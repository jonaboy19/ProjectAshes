		},
		{
			"id": "a1_first_glyph", "act": 1, "title": "Hold the Lantern",
			"objective": "Help Warden Idra relight the stone",
			"journal": "Idra says my hands are quicker than hers. Down, across, up. Don't lift.",
			"giver": "idra_vell", "place": "miller_stone",
			"requires": {"steps": ["a1_dark_stone"]},
			"dialogue": [{"node": "idra_dark_stone", "after": "reach"}],
