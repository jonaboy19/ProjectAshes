     "text": "Tell Quinn Kettle you kept it quiet"
    }
   ],
   "end": true,
   "rewards": {
    "gold": 36,
    "rep": {
     "kingsreach": -2
    },
    "relationship": [
     {
      "npc": "quinn_kettle",
      "label": "Kept quiet about it",
      "value": 15,
