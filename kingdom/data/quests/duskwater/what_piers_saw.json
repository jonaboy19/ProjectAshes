      "duskwater/clue/c2",
      "duskwater/clue/c3"
     ],
     "count": 2,
     "text": "Find two signs that match what Piers said"
    }
   ]
  },
  {
   "id": "decide",
   "title": "Say what you will do",
   "mode": "all",
   "objectives": [
    {
     "id": "verdict",
     "type": "choose",
     "npc": "wilda_gaunt",
     "options": [
