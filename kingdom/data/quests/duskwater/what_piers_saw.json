       "text": "Warn Larkin quietly and leave it",
       "say": "Larkin will owe you. You can see it in the shoulders."
      }
     ]
    }
   ],
   "branches": {
    "name": "named",
    "warn": "warned"
   }
  },
  {
   "id": "named",
   "title": "Wilda hears it",
   "mode": "all",
   "objectives": [
