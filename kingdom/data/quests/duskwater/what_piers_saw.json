  "name": "Wilda Gaunt",
  "place": "duskwater"
 },
 "requires": [
  "duskwater_glass_blanks_for_the_glasswright"
 ],
 "offer_text": "\"Somebody was in my place after dark. Piers Forrest saw something and will not say it loud. Hear Piers, then see if the story holds.\"",
 "stages": [
