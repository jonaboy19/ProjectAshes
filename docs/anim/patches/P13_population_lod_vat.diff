diff --git a/kingdom/scripts/population/population_lod.gd b/kingdom/scripts/population/population_lod.gd
index 8c8def1d..e65900b5 100644
--- a/kingdom/scripts/population/population_lod.gd
+++ b/kingdom/scripts/population/population_lod.gd
@@ -70,6 +70,11 @@ var _held: Dictionary = {}        # person id -> true while its departure is hel
 var _last_time := -1.0
 var _sprite_cache: Dictionary = {}   # person id -> [raw pos, pushed-out ground point]
 var _sprite_hidden: Dictionary = {}  # person id -> true while suppressed inside SPRITE_MIN_DIST
+## Living world (docs/anim/patches/P13_population_lod_vat.md): residents without a full model inside VAT_RANGE
+## are drawn by VatResidents (vertex animation textures, no nodes); embodied villagers get animation LOD.
+const VAT_RANGE := 120.0
+var _vat: VatResidents
+var _anim_lod: CrowdAnimLOD
 
 
 func setup(baker: ImpostorBaker) -> void:
@@ -90,8 +95,17 @@ func setup(baker: ImpostorBaker) -> void:
 		add_child(mmi)
 		_multimeshes[look] = mm
 
+	_vat = VatResidents.new()
+	_vat.name = "VatResidents"
+	_vat.height_fn = WorldGen.height
+	add_child(_vat)
+	_anim_lod = CrowdAnimLOD.new()
+	_anim_lod.vat = _vat.crowd
+	add_child(_anim_lod)
 
 func _process(delta: float) -> void:
+	if _anim_lod and (_anim_lod.camera == null or not is_instance_valid(_anim_lod.camera)):
+		_anim_lod.camera = get_viewport().get_camera_3d()
 	_timer -= delta
 	if _timer <= 0.0:
 		_timer = 0.25
@@ -137,6 +151,8 @@ func refresh() -> void:
 		if not WorldSim.is_indoors(id) and v.global_position.distance_squared_to(focus) < CONTACT_KEEP * CONTACT_KEEP:
 			want_full[id] = true
 			continue
+		if _anim_lod:
+			_anim_lod.unregister(id)
 		_villagers.erase(v)
 		v.queue_free()
 		_full.erase(id)
@@ -167,6 +183,8 @@ func refresh() -> void:
 		used[look] = 0
 	var sprite_budget: int = mini(MAX_SPRITES, Quality.npc_sprites)
 	var sprite_total := 0
+	if _vat:
+		_vat.begin()
 	if _sprite_hidden.size() > 4000:
 		_sprite_hidden.clear()
 	var enter_r2 := SPRITE_MIN_DIST * SPRITE_MIN_DIST
@@ -174,12 +192,19 @@ func refresh() -> void:
 	for entry in dists:
 		# dists is sorted nearest-first, so once the budget is spent everyone
 		# further away is skipped: the crowd is capped in total, not per look.
-		if sprite_total >= sprite_budget:
-			break
 		var id: int = entry[1]
 		if _full.has(id):
 			_sprite_hidden.erase(id)
 			continue
+		if _vat and entry[0] < VAT_RANGE * VAT_RANGE:
+			var gp: Vector2 = WorldSim.pos[id]
+			var cached_g: Array = _sprite_cache.get(id, [])
+			var gy: float = (cached_g[1] as Vector3).y if not cached_g.is_empty() else WorldGen.height(gp.x, gp.y)
+			if _vat.want(id, gp, WorldSim.target[id], WorldSim.job[id], WorldSim.phase[id], gy):
+				_sprite_hidden.erase(id)
+				continue
+		if sprite_total >= sprite_budget:
+			break
 		# Nobody without a full model is drawn as a sprite this close (see
 		# SPRITE_MIN_DIST above); hysteresis keeps the on/off edge from chattering.
 		if _sprite_hidden.get(id, false):
@@ -215,6 +240,8 @@ func refresh() -> void:
 		(_multimeshes[look] as MultiMesh).set_instance_transform(n, t)
 		used[look] = n + 1
 		sprite_total += 1
+	if _vat:
+		_vat.end()
 	sprite_count = 0
 	for look in _multimeshes:
 		(_multimeshes[look] as MultiMesh).visible_instance_count = used[look]
@@ -268,4 +295,14 @@ func _spawn(id: int) -> Villager:
 	v.neighbours = _villagers
 	_villagers.append(v)
 	add_child(v)
+	if _anim_lod:
+		v.set_meta("lw_lod", true)
+		var body: Node3D = null
+		for c in v.get_children():
+			if c is Node3D and not (c as Node).find_children("*", "Skeleton3D", true, false).is_empty():
+				body = c
+				break
+		if body:
+			var mods := body.find_children("*", "LookAtModifier3D", true, false)
+			_anim_lod.register(id, v, body, Assets.animation_player(body), mods[0] if not mods.is_empty() else null, VatResidents.look_of_model(body))
 	return v
diff --git a/kingdom/scripts/population/villager.gd b/kingdom/scripts/population/villager.gd
index c48884f4..492175eb 100644
--- a/kingdom/scripts/population/villager.gd
+++ b/kingdom/scripts/population/villager.gd
@@ -531,6 +531,8 @@ func _set_contact(on: bool) -> void:
 ## refreshed. Contact-range villagers (about to be touched or stepped around)
 ## are excluded from both, so nothing changes for anyone the player can reach.
 func _apply_distance_lod(player_distance: float) -> void:
+	if has_meta("lw_lod"):
+		return      # CrowdAnimLOD owns animation rate, visibility and shadows (P13a section 7)
 	var want_anim := player_distance > LOD_ANIM_DIST and not _contact
 	if want_anim != _anim_lod:
 		_anim_lod = want_anim
