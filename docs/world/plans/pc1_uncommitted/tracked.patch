-func _read_thermal_status() -> int:
-	if _thermal_pm == null:
-		if not Engine.has_singleton("AndroidRuntime"):
-			print("THERMAL api missing: no AndroidRuntime singleton")
-			return -1
-		var rt: Object = Engine.get_singleton("AndroidRuntime")
